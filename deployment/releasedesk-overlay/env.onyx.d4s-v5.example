# =============================================================================
# StaffLess AI .env for ReleaseDesk Everywhere — Azure D4as_v5 (4 vCPU / 16 GB, AMD)
# Engine source: this Stafless-ai fork of onyx-foss (MIT). Compose/API names
# stay as Onyx ships them.
# Same RAM/CPU budget as D4s_v5; compose limits unchanged on Ubuntu 24.04.
# Copy to deployment/docker_compose/.env on the VM. Fill REPLACE_ME.
# Do not commit a filled copy. No real secrets in this file.
# =============================================================================
# Compose usage (from this checkout's deployment/docker_compose):
#   docker compose -f docker-compose.yml -f docker-compose.resources.yml \
#     -f ../releasedesk-overlay/docker-compose.releasedesk.yml build api_server background
#   docker compose -f docker-compose.yml -f docker-compose.resources.yml \
#     -f ../releasedesk-overlay/docker-compose.releasedesk.yml up -d --wait
# =============================================================================

################################################################################
## Image — MUST be a local foss build, not Docker Hub
################################################################################
# Hub onyxdotapp/onyx-backend is built from the MAIN repo and includes ee/.
# onyx-foss does not publish its own registry images. Build from this tree
# (see CHECKLIST.md). Then point compose at the local tag:
ONYX_BACKEND_IMAGE=releasedesk/staffless-backend:local
# Unused when ONYX_BACKEND_IMAGE is set. Do not set IMAGE_TAG=latest and skip
# the build — that pulls Hub (Enterprise-containing) images.
IMAGE_TAG=local

################################################################################
## Auth (required — API refuses to start if USER_AUTH_SECRET is empty)
################################################################################
# openssl rand -hex 32
USER_AUTH_SECRET=REPLACE_ME_openssl_rand_hex_32
# openssl rand -hex 32 — encrypts connector credentials at rest
ENCRYPTION_KEY_SECRET=REPLACE_ME_openssl_rand_hex_32
# Optional: lock /metrics. Leave unset to keep /metrics 401 (safer default).
# METRICS_AUTH_TOKEN=REPLACE_ME_metrics_bearer
# Temporary during first-time setup so /docs and /openapi.json exist. Set false after setup-onyx.sh.
ENABLE_PUBLIC_DOCS=true
# Public origin nginx and auth redirects should use (no trailing slash).
WEB_DOMAIN=http://REPLACE_ME_HOST_OR_IP

################################################################################
## Edition — foss has no backend/ee. Keep paid flag off.
################################################################################
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=false
# Default is true. On Hub (main) images that flag=false would unlock paid
# routes — never set it there. On a foss-built image there is no EE middleware
# to unlock. Leave this false so leftover MIT code does not set is_ee_version()
# and then hard-import missing ee.onyx.utils.tier (PATCH /admin/settings).
LICENSE_ENFORCEMENT_ENABLED=false

################################################################################
## Search backend — OpenSearch on, Vespa off (these are also the code defaults)
################################################################################
ONYX_DISABLE_VESPA=true
ENABLE_OPENSEARCH_INDEXING_FOR_ONYX=true
OPENSEARCH_HOST=opensearch
# OpenSearch 3.x requires a strong initial admin password (not "admin").
OPENSEARCH_ADMIN_PASSWORD=REPLACE_ME_strong_opensearch_password
# Neo4j initial user is neo4j. Must not be the password "neo4j".
# Compose refuses to start the neo4j service if this is unset.
NEO4J_PASSWORD=REPLACE_ME_strong_neo4j_password

################################################################################
## Local model server ON — one shared SentenceTransformer encoder
## (Qwen/Qwen3-Embedding-0.6B). Do not start indexing_model_server (second 5g).
## Do not use TEI for this model (no ONNX build; warmup OOM on this VM).
################################################################################
ONYX_MODEL_SERVER_IMAGE=releasedesk/staffless-model-server:local
DISABLE_MODEL_SERVER=false
MODEL_SERVER_HOST=inference_model_server
INDEXING_MODEL_SERVER_HOST=inference_model_server
INFERENCE_CPU_LIMIT=2.0
INFERENCE_MEM_LIMIT=4g
# TEI reranker (compose service reranker). Off until api_server env is
# updated on purpose — flipping this recreates api_server.
ENABLE_RERANK=false
RERANKER_URL=http://reranker:80
# Recency re-sort after hybrid dedupe. Off until measured. Recreate api_server
# if this line is changed on a running VM.
ENABLE_RECENCY_BIAS=false

################################################################################
## Postgres / Redis
################################################################################
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_strong_postgres_password
POSTGRES_HOST=relational_db
REDIS_HOST=cache

################################################################################
## File store — Postgres, skip MinIO (saves RAM on D4as_v5 / 16 GB)
################################################################################
# Do not set COMPOSE_PROFILES=s3-filestore. Empty / unset keeps MinIO off.
COMPOSE_PROFILES=
FILE_STORE_BACKEND=postgres

################################################################################
## Document Push → Neo4j-writer (PHASE 2 — leave unset this phase)
################################################################################
# Fill when the bolt-on service exists. Community env hook; not the EE /admin/hooks UI.
# DOCUMENT_PUSH_ENDPOINT_URL=http://REPLACE_ME_NEO4J_WRITER:PORT/documents
# DOCUMENT_PUSH_API_KEY=REPLACE_ME_shared_secret
# DOCUMENT_PUSH_TIMEOUT_SECONDS=30

################################################################################
## D4as_v5 resource limits (consumed by docker-compose.resources.yml + overlay)
## Host has 16 GB. OS change (24.04 vs 22.04) does not change these numbers.
## Do not use stock resources.yml defaults (background 10g + api 4g + postgres
## 4g would OOM the VM).
################################################################################
API_SERVER_CPU_LIMIT=1.0
API_SERVER_MEM_LIMIT=1536m
BACKGROUND_CPU_LIMIT=1.5
# 2g is too small: celery workers are MEMCG-OOM-killed while indexing Jira
# (Heartbeat stale / workers crashed holding batches). Host D4as_v5 still
# has ~10g available at 2g; raise the cgroup and shrink in-flight work.
BACKGROUND_MEM_LIMIT=4g
# Stock defaults are 16 docs/batch and 6 docprocessing workers (96 docs in
# RAM). That is what fills the background cgroup.
INDEX_BATCH_SIZE=4
CELERY_WORKER_DOCPROCESSING_CONCURRENCY=2
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=1g
NGINX_CPU_LIMIT=0.25
NGINX_MEM_LIMIT=128m
# Overlay also caps OpenSearch at 2g with 1g heap. Redis 256m.
# CPU TEI reranker (overlay service). Internal http://reranker:80 only.
# Do not set this on a running api_server .env just to add the comment —
# changing live .env recreates api_server. Start reranker with scoped
# `up -d --no-deps --wait reranker`.
RERANKER_CPU_LIMIT=2.0
# 3g / 1 CPU sat the cgroup. 5g / 2 CPU uses host headroom; other limits unchanged.
RERANKER_MEM_LIMIT=5g

################################################################################
## Pointers (match stock env.template; model hosts overridden above)
################################################################################
INTERNAL_URL=http://api_server:8080

################################################################################
## Craft / extra — keep off
################################################################################
ENABLE_CRAFT=false
